# Simplified Firebird build makefile for the vendored NetBSD libedit sources.
@SET_MAKE@

@WIDECHAR_TRUE@wide_objects = $(OBJ_DIR)/eln.o $(OBJ_DIR)/historyn.o $(OBJ_DIR)/tokenizern.o
@HAVE_STRLCPY_FALSE@strlcpy_object = $(OBJ_DIR)/strlcpy.o
@HAVE_STRLCAT_FALSE@strlcat_object = $(OBJ_DIR)/strlcat.o
@HAVE_VIS_FALSE@vis_object = $(OBJ_DIR)/vis.o
@HAVE_VIS_FALSE@unvis_object = $(OBJ_DIR)/unvis.o

OBJ_DIR = ../../../temp/extern/editline
LIBRARY = ../../../gen/extern/editline/libedit.a
CONFIG_HEADER = ../config.h

OBJECTS = \
	$(OBJ_DIR)/chared.o \
	$(OBJ_DIR)/chartype.o \
	$(OBJ_DIR)/common.o \
	$(OBJ_DIR)/el.o \
	$(OBJ_DIR)/emacs.o \
	$(OBJ_DIR)/filecomplete.o \
	$(OBJ_DIR)/hist.o \
	$(OBJ_DIR)/history.o \
	$(OBJ_DIR)/keymacro.o \
	$(OBJ_DIR)/literal.o \
	$(OBJ_DIR)/map.o \
	$(OBJ_DIR)/parse.o \
	$(OBJ_DIR)/prompt.o \
	$(OBJ_DIR)/read.o \
	$(OBJ_DIR)/readline.o \
	$(OBJ_DIR)/refresh.o \
	$(OBJ_DIR)/search.o \
	$(OBJ_DIR)/sig.o \
	$(OBJ_DIR)/terminal.o \
	$(OBJ_DIR)/tokenizer.o \
	$(OBJ_DIR)/tty.o \
	$(OBJ_DIR)/vi.o \
	$(OBJ_DIR)/wcsdup.o \
	$(wide_objects) \
	$(strlcpy_object) \
	$(strlcat_object) \
	$(vis_object) \
	$(unvis_object)

DEFAULT_INCLUDES = -I. -I..
COMPILE = $(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) \
	$(CPPFLAGS) $(CFLAGS)

OPTFLAGS = -O2
DEPFLAGS = -pipe -MMD -fPIC

AR = @AR@
AWK = @AWK@
CC = @CC@
CFLAGS = @CFLAGS@
CPPFLAGS = @CPPFLAGS@
STATICLIB_LINK = $(AR) crus
SHELL = @SHELL@

srcdir = .
VPATH = $(srcdir)

BUILT_SOURCES = vi.h emacs.h common.h fcns.h func.h help.h
AHDR = vi.h emacs.h common.h
ASRC = $(srcdir)/vi.c $(srcdir)/emacs.c $(srcdir)/common.c
CLEANFILES = $(BUILT_SOURCES)

editlinelibrary: all

all: $(BUILT_SOURCES)
	$(MAKE) $(LIBRARY)

.SUFFIXES:
.SUFFIXES: .c .o

$(LIBRARY): $(OBJECTS)
	mkdir -p $(dir $@)
	-$(RM) $@
	$(STATICLIB_LINK) $@ $^

$(OBJ_DIR)/%.o: %.c | $(OBJ_DIR)
	$(COMPILE) $(DEPFLAGS) $(OPTFLAGS) -c $< -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

clean:
	rm -f $(CLEANFILES) $(OBJECTS) $(Dependencies)

distclean: clean
	rm -f $(LIBRARY) Makefile ../Makefile

.PHONY: editlinelibrary all clean distclean

vi.h: Makefile $(srcdir)/vi.c
	AWK=$(AWK) sh $(srcdir)/makelist -h $(srcdir)/vi.c > $@

emacs.h: Makefile $(srcdir)/emacs.c
	AWK=$(AWK) sh $(srcdir)/makelist -h $(srcdir)/emacs.c > $@

common.h: Makefile $(srcdir)/common.c
	AWK=$(AWK) sh $(srcdir)/makelist -h $(srcdir)/common.c > $@

fcns.h: Makefile $(AHDR)
	AWK=$(AWK) sh $(srcdir)/makelist -fh $(AHDR) > $@

func.h: Makefile $(AHDR)
	AWK=$(AWK) sh $(srcdir)/makelist -fc $(AHDR) > $@

help.h: Makefile $(ASRC)
	AWK=$(AWK) sh $(srcdir)/makelist -bh $(ASRC) > $@

Dependencies = $(OBJECTS:.o=.d)
-include $(Dependencies)

.NOEXPORT:
